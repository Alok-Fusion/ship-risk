{
  "name": "ship-risk",
  "version": "1.0.0",
  "description": "AI-Code Readiness Scanner - Spot the gap between 'AI says it's done' and production-ready code with explainable risk scoring.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ship-risk": "bin/ship-risk.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node bin/ship-risk.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ai-code",
    "code-quality",
    "readiness-score",
    "security-scanner",
    "static-analysis",
    "ast",
    "express",
    "nextjs",
    "code-audit",
    "ci-gate",
    "cli"
  ],
  "author": "Alok Kushwaha (https://github.com/Alok-Fusion)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alok-Fusion/ship-risk.git"
  },
  "homepage": "https://github.com/Alok-Fusion/ship-risk#readme",
  "bugs": {
    "url": "https://github.com/Alok-Fusion/ship-risk/issues"
  },
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@babel/types": "^7.26.9",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/picomatch": "^3.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ]
}
